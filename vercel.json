{
  "redirects": [
    { "source": "/become-a-speaker",    "destination": "/", "permanent": true },
    { "source": "/become-a-speaker/",   "destination": "/", "permanent": true },
    { "source": "/sponsors",            "destination": "/partners", "permanent": true },
    { "source": "/sponsors/",           "destination": "/partners", "permanent": true },
    { "source": "/registration",        "destination": "/tickets", "permanent": true },
    { "source": "/registration/",       "destination": "/tickets", "permanent": true },
    { "source": "/register",            "destination": "/tickets", "permanent": true },
    { "source": "/register/",           "destination": "/tickets", "permanent": true },
    { "source": "/photo-gallery",       "destination": "/", "permanent": true },
    { "source": "/photo-gallery/",      "destination": "/", "permanent": true },
    { "source": "/uk/:path*",           "destination": "/", "permanent": true },
    { "source": "/es/:path*",           "destination": "/", "permanent": true },
    { "source": "/en/:path*",           "destination": "/", "permanent": true },
    { "source": "/fotogalereya",        "destination": "/", "permanent": true },
    { "source": "/fotogalereya/",       "destination": "/", "permanent": true },
    { "source": "/staty-spikerom",      "destination": "/", "permanent": true },
    { "source": "/staty-spikerom/",     "destination": "/", "permanent": true },
    { "source": "/partnery",            "destination": "/partners", "permanent": true },
    { "source": "/partnery/",           "destination": "/partners", "permanent": true },
    { "source": "/reyestratsiia",       "destination": "/tickets", "permanent": true },
    { "source": "/reyestratsiia/",      "destination": "/tickets", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/registration-details",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/registration-details/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
